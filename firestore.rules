rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    // Check if the user email matches approved administrator domains or addresses
    function isAuthorizedEmail() {
      return isAuthenticated() && (
        request.auth.token.email == 'mramsay0@gmail.com' ||
        request.auth.token.email == 'mramsayo@gmail.com' ||
        request.auth.token.email == 'erneleducation@gmail.com' ||
        request.auth.token.email.matches('.*@eloingle\\.com\\.br') ||
        request.auth.token.email.matches('.*@eloingles\\.com\\.br') ||
        request.auth.token.email.matches('.*@elospeak\\.com\\.br') ||
        request.auth.token.email.matches('.*@elospeak\\.com')
      );
    }

    // Safely check if the user profile exists and has role 'admin'
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.uid == 'QI3mgrlplVSNPER0VxuZIPSlo2B3' ||
        isAuthorizedEmail() || (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
        )
      );
    }
    
    // Safely check if the user profile exists and has role 'tutor' or 'admin'
    function isTutor() {
      return isAuthenticated() && (
        request.auth.uid == 'QI3mgrlplVSNPER0VxuZIPSlo2B3' ||
        isAuthorizedEmail() || (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'tutor' ||
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
          )
        )
      );
    }

    // Check if user is the corporate HR manager for a given organization ID
    function isOrgAdminOf(orgId) {
      return isAuthenticated() && (
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'org_admin' &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.organizationId == orgId
      );
    }
    
    // Users collection rules
    match /users/{userId} {
      allow read: if isAuthenticated() && (
        isOwner(userId) || 
        isTutor() ||
        (resource != null && resource.data.referredBy != null && resource.data.referredBy == request.auth.uid) ||
        (resource != null && resource.data.organizationId != null && isOrgAdminOf(resource.data.organizationId))
      );
      
      allow create: if isAuthenticated() && (
        isOwner(userId) ||
        (
          request.resource.data.organizationId != null &&
          isOrgAdminOf(request.resource.data.organizationId) &&
          request.resource.data.plan == 'corporate'
        )
      );
      
      allow update: if isAuthenticated() && (
        request.auth.uid == 'QI3mgrlplVSNPER0VxuZIPSlo2B3' ||
        isAdmin() || 
        // Allow B2B Org Admin to adjust credits/profiles of employees in their organization
        (
          resource.data.organizationId != null &&
          isOrgAdminOf(resource.data.organizationId) &&
          request.resource.data.role == resource.data.role &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'uid', 'email'])
        ) ||
        (
          isOwner(userId) && (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'plan', 'bookingLimit', 'organizationId', 'corporateCredits']) ||
            (
              request.resource.data.role == resource.data.role &&
              request.resource.data.plan == resource.data.plan &&
              !request.resource.data.diff(resource.data).affectedKeys().hasAny(['bookingLimit', 'organizationId', 'corporateCredits'])
            )
          )
        )
      );
      
      allow delete: if isAuthenticated() && (
        isOwner(userId) ||
        isAdmin() ||
        request.auth.uid == 'QI3mgrlplVSNPER0VxuZIPSlo2B3'
      );
      
      // User enrollments sub-collection (legacy but still active)
      match /courses/{courseId} {
        allow read, write: if isAuthenticated() && (isOwner(userId) || isTutor());
      }
      
      // User notifications sub-collection
      match /notifications/{notifId} {
        allow read, write: if isAuthenticated() && (isOwner(userId) || isTutor());
      }
      
      // Flashcards sub-collection (Phase 3 readiness)
      match /flashcards/{cardId} {
        allow read, write: if isAuthenticated() && (isOwner(userId) || isTutor());
      }
    }
    
    // Bookings collection rules
    match /bookings/{bookingId} {
      allow read: if isAuthenticated();
      
      allow create: if isAuthenticated() && (
        request.resource.data.userId == request.auth.uid ||
        request.resource.data.uid == request.auth.uid
      );
      
      allow update: if isAuthenticated() && (
        isTutor() || (
          (isOwner(resource.data.userId) || isOwner(resource.data.uid)) &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['userId', 'uid'])
        )
      );
      
      allow delete: if isAuthenticated() && (
        isOwner(resource.data.userId) || 
        isOwner(resource.data.uid) || 
        isTutor()
      );
    }
    
    // Slots collection rules (available booking times)
    match /slots/{slotId} {
      allow read: if isAuthenticated();
      allow write: if isTutor();
    }
    
    // Legacy available slots collection rules
    match /availableSlots/{slotId} {
      allow read: if isAuthenticated();
      allow write: if isTutor();
    }

    // Blocked slots collection rules (tutor day/time off)
    match /blockedSlots/{slotId} {
      allow read: if isAuthenticated();
      allow write: if isTutor();
    }

    match /tutor_applications/{appId} {
      allow create: if isAuthenticated() && request.auth.uid == appId;
      allow read: if isAdmin() || (isAuthenticated() && request.auth.uid == appId);
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Tutors collection rules
    match /tutors/{tutorId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    
    // Enrollments collection rules (root enrollments)
    match /enrollments/{enrollmentId} {
      allow read: if isAuthenticated() && (
        isOwner(resource.data.userId) || 
        isOwner(resource.data.uid) || 
        isTutor()
      );
      allow create: if isAuthenticated() && (
        request.resource.data.userId == request.auth.uid ||
        request.resource.data.uid == request.auth.uid
      );
      allow update: if isAuthenticated() && (
        isOwner(resource.data.userId) || 
        isOwner(resource.data.uid) || 
        isTutor()
      );
      allow delete: if isTutor();
    }

    // Blocked slots collection rules (for Tutor Days/Hours Off)
    match /blockedSlots/{slotId} {
      allow read: if isAuthenticated();
      allow write: if isTutor();
    }

    // Settings collection rules (Matt's availability presence status, tutor contact, classroom)
    match /settings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isTutor();
    }

    // Booking cancellations rules (For admin analytics tracking)
    match /booking_cancellations/{cancelId} {
      allow read: if isTutor();
      allow create: if isAuthenticated() && request.resource.data.studentId == request.auth.uid;
      allow update, delete: if false;
    }

    // Audit logs rules (For security tracing)
    match /audit_logs/{logId} {
      allow read: if isTutor();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
