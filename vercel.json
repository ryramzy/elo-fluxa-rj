{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/calendar/(.*)",
      "destination": "/api/calendar.ts"
    },
    {
      "source": "/api/available-slots",
      "destination": "/api/calendar.ts"
    },
    {
      "source": "/api/email/(.*)",
      "destination": "/api/email.ts"
    },
    {
      "source": "/api/cron/(.*)",
      "destination": "/api/admin.ts"
    },
    {
      "source": "/api/checkout",
      "destination": "/api/checkout.ts"
    },
    {
      "source": "/api/webhooks/(.*)",
      "destination": "/api/admin.ts"
    },
    {
      "source": "/api/force-create-slots",
      "destination": "/api/admin.ts"
    },
    {
      "source": "/api/stripe/(.*)",
      "destination": "/api/stripe.ts"
    },

    {
      "source": "/api/health",
      "destination": "/api/health.ts"
    },
    {
      "source": "/api/whatsapp",
      "destination": "/api/whatsapp.ts"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/email/lesson-reminder",
      "schedule": "0 11 * * *"
    },
    {
      "path": "/api/cron/b2b-report",
      "schedule": "0 10 * * 1"
    }
  ]
}
